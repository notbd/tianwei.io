# ============================================================
# Environment configuration for tianwei.io (Next.js frontend)
# ============================================================
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real credentials.
# On Vercel, set these in the project's Environment Variables.
# ============================================================

# Base URL of the content API (no trailing slash)
# Local API: http://127.0.0.1:3001 · Production: https://tio.twz.app
CONTENT_API_URL=https://tio.twz.app

# Cloudinary cloud name for MDX images (public, exposed to the client)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Bearer token protecting POST /api/revalidate
# (must match the content engine's REVALIDATION_SECRET)
REVALIDATION_SECRET=replace-with-a-long-random-string

# Optional: enables draft preview (/api/preview?secret=...&slug=...).
# Must match the API's PREVIEW_SECRET Worker secret. Min 16 chars.
# PREVIEW_SECRET=
